{
  "name": "milpa/admin",
  "description": "The administration panel of the Milpa PHP framework: a discoverable section shell over the plugin, settings and routing surfaces a host exposes \u2014 server-rendered, no JavaScript required.",
  "keywords": [
    "php",
    "milpa",
    "framework",
    "admin-panel",
    "server-rendered",
    "plugins",
    "no-javascript"
  ],
  "type": "library",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Rodrigo Vicente - TeamX Agency",
      "homepage": "https://x.com/rodrigoteamx"
    }
  ],
  "require": {
    "php": ">=8.3",
    "guzzlehttp/psr7": "^2.6",
    "milpa/auth": "^0.3.1",
    "milpa/command": "^0.3.1 || ^0.4 || ^0.5 || ^0.6 || ^0.7",
    "milpa/console": "^0.6 || ^0.7",
    "milpa/core": "^0.6.2 || ^0.7",
    "milpa/data": "^0.2",
    "milpa/http": "^0.1.5",
    "milpa/http-symfony": "^0.1",
    "milpa/live": "^0.4",
    "milpa/live-tui": "^0.4 || ^0.5 || ^0.6 || ^0.7",
    "milpa/live-web": "^0.2",
    "milpa/plugin": "^0.7 || ^0.8 || ^0.9 || ^0.10",
    "milpa/runtime": "^0.7",
    "milpa/tool-runtime": "^0.9",
    "psr/log": "^3",
    "symfony/http-foundation": "^7.4",
    "symfony/psr-http-message-bridge": "^7.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.65",
    "milpa/container": "^0.1",
    "phpstan/phpdoc-parser": "^2.3",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Milpa\\Admin\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Milpa\\Admin\\Tests\\": "tests/",
      "Milpa\\Docs\\": "vendor/milpa/core/tools/gen-docs/"
    }
  }
}
