{
  "name": "milpa/admin",
  "description": "The administration panel of the Milpa PHP framework: a discoverable section shell over the plugin, settings and routing surfaces a host exposes \u2014 server-rendered, no JavaScript required.",
  "type": "library",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Rodrigo Vicente - TeamX Agency",
      "homepage": "https://x.com/rodrigoteamx"
    }
  ],
  "require": {
    "guzzlehttp/psr7": "^2.6",
    "milpa/auth": "^0.2",
    "milpa/command": "^0.2",
    "milpa/core": "^0.6",
    "milpa/data": "^0.2",
    "milpa/http": "^0.1.5",
    "milpa/http-symfony": "^0.1",
    "milpa/live": "^0.2",
    "milpa/live-tui": "^0.3",
    "milpa/live-web": "^0.2",
    "milpa/plugin": "^0.3",
    "milpa/runtime": "^0.5",
    "milpa/tool-runtime": "^0.6",
    "php": ">=8.3",
    "psr/log": "^3",
    "symfony/http-foundation": "^7.4",
    "symfony/psr-http-message-bridge": "^7.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.65",
    "milpa/container": "^0.1",
    "phpstan/phpdoc-parser": "^2.3",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Milpa\\Admin\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Milpa\\Admin\\Tests\\": "tests/",
      "Milpa\\Docs\\": "vendor/milpa/core/tools/gen-docs/"
    }
  }
}
